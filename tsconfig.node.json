{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["electron.vite.config.ts", "vitest.config.mts", "scripts/**/*", "tests/**/*", "src/main/**/*", "src/preload/**/*", "src/coordinator/**/*", "src/shared/**/*"],
  "exclude": ["tests/remote-client-render.test.ts", "tests/spec028-verify-render.test.ts"]
}
