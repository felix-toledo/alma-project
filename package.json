{
  "name": "alma",
  "productName": "Alma",
  "version": "0.1.0",
  "description": "Alma: agente de escritorio (Claude / Grok / DeepSeek) con subagentes, herramientas locales, MCP y biblioteca de imágenes",
  "private": true,
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && pnpm run build:remote",
    "build:remote": "vite build --config vite.remote.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.remote.json",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:debt": "biome lint --diagnostic-level=warn --max-diagnostics=50 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:tests": "node scripts/require-tests.mts",
    "check:fast": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run check:tests",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@huggingface/transformers": "4.3.1",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xmldom/xmldom": "0.9.12",
    "baileys": "6.7.24",
    "docx": "9.8.1",
    "docx-preview": "0.4.1",
    "espeak-ng": "1.0.2",
    "exceljs": "4.4.0",
    "grammy": "^1.46.0",
    "imapflow": "2.1.2",
    "jszip": "3.10.2",
    "lucide-react": "^1.57.0",
    "mailparser": "3.9.32",
    "nodemailer": "10.4.0",
    "ogg-opus-decoder": "1.7.5",
    "onnxruntime-node": "1.30.0",
    "openai": "^7.34.0",
    "papaparse": "5.7.0",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "0.1.9",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "^44.10.2",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
