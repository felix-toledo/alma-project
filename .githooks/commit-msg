#!/bin/sh
# Conventional commits, and no AI co-author trailers (project rule, see .specify/memory/constitution.md).
msg=$(head -n1 "$1")
case "$msg" in Merge*|Revert*|fixup!*|squash!*) exit 0 ;; esac
echo "$msg" | grep -Eq '^(feat|fix|refactor|test|docs|chore|ci|perf|build)(\([a-z0-9._-]+\))?!?: .{3,}' || {
  echo "commit-msg: use 'type(scope): summary' with type feat|fix|refactor|test|docs|chore|ci|perf|build" >&2
  exit 1
}
if grep -qi '^co-authored-by:.*\(claude\|anthropic\)' "$1"; then
  echo "commit-msg: remove the Co-Authored-By trailer for Claude" >&2
  exit 1
fi
